# Managed by devenv. Edit this tracked file, then reload with Cmd+Shift+,.
# Ghostty provides these Catppuccin themes and JetBrains Mono itself.
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
font-family = JetBrains Mono
font-size = 14
font-thicken = true

# Give the text room to breathe while keeping padding visually balanced.
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-save-state = always
macos-titlebar-style = transparent

cursor-style = bar
cursor-style-blink = true
copy-on-select = false

# Enables prompt navigation, working-directory inheritance, and correct
# prompt redraws. Ghostty injects its Zsh integration automatically.
shell-integration = zsh
shell-integration-features = cursor,no-sudo,title,no-ssh-env,no-ssh-terminfo,path
